# KnowledgeBot 首次部署模板：仅在你自己的电脑填写，不要将填好的 .env 发给别人。
# 双击 start.command 会复制本模板，并自动生成随机 API_TOKEN。

# ── 1. 必填：Notion 内部集成令牌与已授权的私有父页面 ──
# 在 https://www.notion.so/profile/integrations 创建内部集成，开启读取/插入/更新内容。
NOTION_TOKEN=
# 在父页面右上角「… → 连接」添加 KnowledgeBot，再复制该页面链接。
# 首次启动器会在此页面下创建 Knowledge Base、Collections、AI Jobs。
NOTION_PARENT_PAGE_URL=
# 启动器自动填写下面三个 ID；已有数据源的高级用户也可手动填写，不能填 view ID。
NOTION_KNOWLEDGE_DATA_SOURCE_ID=
NOTION_COLLECTIONS_DATA_SOURCE_ID=
NOTION_JOBS_DATA_SOURCE_ID=
NOTION_VERSION=2026-03-11

# ── 2. 本地控制台鉴权 ──
# 首次自动生成；手工配置时须为至少 24 字符的随机串，不是 Notion/DeepSeek 的密钥。
API_TOKEN=
PORT=3000
NODE_ENV=development

# ── 3. AI：默认 Mock，免额度完成首次验证 ──
# 使用真实 DeepSeek 时改为 AI_PROVIDER=deepseek、MOCK_AI=false，并填写密钥。
AI_PROVIDER=mock
MOCK_AI=true
DEEPSEEK_API_KEY=
# DeepSeek 默认地址与模型由系统自动选择；自定义接口在此填写。
AI_BASE_URL=
AI_MODEL=
AI_REASONING_MODEL=
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── 4. 图片与扫描 PDF ──
# auto 优先 macOS Vision；首次编译辅助程序可能需要 Apple Command Line Tools。
# 与 DeepSeek 文本模型完全分离。OCR 不可用时可在 GUI 单独配置视觉 API。
OCR_ENGINE=auto
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini

# ── 5. 免安装本地数据库与文件目录，无需 PostgreSQL / R2 ──
DATABASE_URL=local
LOCAL_DATA_DIR=./data
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
# iCloud 路径可在设置页选择；数据库和密钥不要放入同步盘。

# ── 6. 分类与费用上限 ──
CATEGORIES=AI 与大模型|编程与开发|GitHub 项目|科研与论文|学习与课程|网络与服务器|软件与工具|生活与消费|旅行|灵感与待研究|其他
MAX_FILE_BYTES=20971520
MAX_MONTHLY_AI_CALLS=1000
DOWNLOAD_TTL_SECONDS=900
# 默认阻止代理 Fake-IP 地址；确认是自己的代理 DNS 后才能在必要时启用。
ALLOW_DNS_PROXY_RANGE=false

# ── 7. 可选云端模式：本地用户全部留空 ──
PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
